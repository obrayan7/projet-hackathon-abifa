# --- Base de données (Supabase / PostgreSQL) ---
# Supabase : DATABASE_URL = "Transaction pooler" (port 6543, ajouter ?pgbouncer=true) ; DIRECT_URL = "Session pooler" (port 5432, IPv4 compatible)
DATABASE_URL="postgresql://postgres.PROJET:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJET:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Serveur ---
NODE_ENV=development
PORT=4000
JWT_SECRET="remplacez-par-une-longue-valeur-aleatoire-d-au-moins-32-caracteres"
FILE_SIGNING_SECRET="remplacez-par-une-autre-valeur-aleatoire"
# Origines autorisées (CORS). L'administration est hébergée à part.
FRONTEND_ORIGIN=http://localhost:4000
ADMIN_ORIGIN=http://localhost:5173
# lax si frontend et API partagent le même site ; none (+ HTTPS) si hébergés sur des sites différents
COOKIE_SAMESITE=lax
# Le backend sert le frontend (jeune + entreprise). Mettre SERVE_FRONTEND=false si hébergé ailleurs.
# Sur Vercel : SERVE_FRONTEND=false (le site est un projet Vercel séparé)
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend
STORAGE_DIR=./storage

# --- IA (la clé reste ici, jamais dans le frontend) ---
# anthropic | openai (compatible Chat Completions) | none (réponse de secours)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Transcription des notes vocales (API compatible OpenAI /audio/transcriptions)
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Supabase Storage (production sur Vercel : livrables des jeunes) ---
# Laisser vide en local : les fichiers sont alors stockés dans STORAGE_DIR. Clé "service_role" = SECRÈTE (jamais dans le frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=submissions

# --- Paiement PRO ---
# sandbox : simulateur serveur (refusé en production). Brancher le prestataire retenu dans src/services/paymentProvider.js
PAYMENT_PROVIDER=sandbox
# Autorise le simulateur de paiement EN PRODUCTION (démonstration seulement). À retirer avant tout lancement commercial.
ALLOW_SANDBOX_PAYMENTS=false
PAYMENT_WEBHOOK_SECRET="secret-partage-avec-le-prestataire"
PRO_PRICE_XOF=1450
PRO_DAYS=30

# --- Premier administrateur (npm run db:seed) ---
ADMIN_EMAIL=admin@votre-domaine.bj
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
